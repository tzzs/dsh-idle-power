{
  "name": "dsh-idle-power",
  "version": "0.1.0",
  "description": "Hibernate or shut down Windows once every DeepSeek Harness task has finished, with a visible 60-second countdown you can cancel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.cjs",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.cjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "power-management",
    "shutdown",
    "hibernate",
    "sleep",
    "idle",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzzs/dsh-idle-power.git"
  },
  "homepage": "https://github.com/tzzs/dsh-idle-power#readme",
  "bugs": {
    "url": "https://github.com/tzzs/dsh-idle-power/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
